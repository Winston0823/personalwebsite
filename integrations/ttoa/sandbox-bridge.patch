diff --git a/lib/camera.ts b/lib/camera.ts
--- /dev/null
+++ b/lib/camera.ts
@@ -0,0 +1,36 @@
+/** Request inside the Start gesture; release streams that arrive after timeout. */
+export function requestCamera(
+  media: Pick<MediaDevices, "getUserMedia"> | undefined,
+  timeoutMs = 15000,
+): Promise<MediaStream> {
+  if (!media?.getUserMedia) {
+    return Promise.reject(new Error("Camera access is unavailable in this browser. Open the app in Chrome or Safari over HTTPS (or localhost)."));
+  }
+  return new Promise((resolve, reject) => {
+    let settled = false;
+    const timer = setTimeout(() => {
+      settled = true;
+      reject(new Error("No camera response. Check the browser’s camera permission, or use Open app to try outside the simulator."));
+    }, timeoutMs);
+    media.getUserMedia({ video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } }, audio: false }).then(stream => {
+      if (settled) { stream.getTracks().forEach(track => track.stop()); return; }
+      settled = true;
+      clearTimeout(timer);
+      resolve(stream);
+    }, error => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      const name = error instanceof Error ? error.name : "";
+      reject(new Error(
+        name === "NotAllowedError" || name === "SecurityError"
+          ? "Camera access is blocked. Allow camera access in your browser’s site settings, then try again. If embedded access is blocked, use Open app."
+          : name === "NotFoundError"
+            ? "No camera was found. Connect a camera, then try again."
+            : name === "NotReadableError"
+              ? "The camera could not be opened. Close other apps using it and check your system’s camera permissions."
+              : "The camera could not start. Check your browser’s camera permission or try Open app."
+      ));
+    });
+  });
+}
diff --git a/scripts/camera.test.mjs b/scripts/camera.test.mjs
--- /dev/null
+++ b/scripts/camera.test.mjs
@@ -0,0 +1,26 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { requestCamera } from '../lib/camera.ts';
+
+test('requests video without audio and returns the stream', async () => {
+  const stream = { getTracks: () => [] };
+  const result = await requestCamera({ getUserMedia: async constraints => {
+    assert.equal(constraints.audio, false);
+    assert.equal(constraints.video.facingMode, 'user');
+    return stream;
+  }});
+  assert.equal(result, stream);
+});
+test('unsupported and blocked cameras return actionable failures', async () => {
+  await assert.rejects(requestCamera(undefined), /unavailable/);
+  await assert.rejects(requestCamera({getUserMedia: async () => { throw new DOMException('Denied', 'NotAllowedError'); }}), /site settings/);
+});
+test('an unanswered request times out and releases a late stream', async () => {
+  let finish;
+  let stopped = false;
+  const pending = requestCamera({getUserMedia: () => new Promise(resolve => { finish = resolve; })}, 5);
+  await assert.rejects(pending, /No camera response/);
+  finish({getTracks: () => [{stop: () => { stopped = true; }}]});
+  await Promise.resolve();
+  assert.equal(stopped, true);
+});
