diff --git a/lib/sandbox-bridge.ts b/lib/sandbox-bridge.ts
--- /dev/null
+++ b/lib/sandbox-bridge.ts
@@ -0,0 +1,152 @@
+/** Optional, origin-checked adapter for Winston's prototype workbench. */
+import { CONFIG } from "./config";
+
+const fonts: Record<string, string> = {
+  original: 'ui-rounded, "SF Pro Rounded", system-ui, sans-serif',
+  editorial: 'Georgia, "Times New Roman", serif',
+  mono: "ui-monospace, Menlo, Consolas, monospace",
+};
+const allowedInk = [
+  "voidTop",
+  "voidBottom",
+  "waterTop",
+  "waterMid",
+  "waterDeep",
+  "surface",
+  "caustic",
+  "rope",
+  "splat",
+  "rareGlow",
+] as const;
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  typeof value === "object" && value !== null && !Array.isArray(value);
+const hex = (value: unknown): value is string =>
+  typeof value === "string" && /^#[0-9a-f]{6}$/i.test(value);
+const rgb = (value: string) =>
+  [1, 3, 5]
+    .map((index) => parseInt(value.slice(index, index + 2), 16))
+    .join(" ");
+
+export function attachSandboxBridge() {
+  const query = new URLSearchParams(location.search);
+  if (query.get("sandbox") !== "1" || window.parent === window) return () => {};
+  const origin = query.get("parentOrigin");
+  const allowed = [
+    "http://localhost:3000",
+    "http://127.0.0.1:3000",
+    ...(process.env.NEXT_PUBLIC_SANDBOX_ORIGINS ?? "")
+      .split(",")
+      .map((value) => value.trim()),
+  ];
+  if (!origin || !allowed.includes(origin)) return () => {};
+  const baseline = structuredClone(CONFIG);
+  const root = document.documentElement;
+  root.dataset.sandboxConnected = "true";
+  const ready = () =>
+    window.parent.postMessage(
+      {
+        type: "winston:ready",
+        version: 1,
+        prototype: "ttoa",
+        capabilities: ["ink", "font", "button", "layout", "feel"],
+      },
+      origin,
+    );
+  const message = (event: MessageEvent) => {
+    if (
+      event.origin !== origin ||
+      event.source !== window.parent ||
+      !isRecord(event.data) ||
+      event.data.version !== 1
+    )
+      return;
+    if (event.data.type === "winston:hello") {
+      ready();
+      return;
+    }
+    if (
+      event.data.type === "winston:action" &&
+      event.data.action === "start-touch" &&
+      query.get("sandboxInput") === "touch"
+    ) {
+      window.dispatchEvent(new Event("sandbox:start-touch"));
+      return;
+    }
+    if (event.data.type !== "winston:apply" || !isRecord(event.data.settings))
+      return;
+    const settings = event.data.settings;
+    if (
+      !isRecord(settings.ink) ||
+      !allowedInk.every((key) =>
+        hex((settings.ink as Record<string, unknown>)[key]),
+      )
+    )
+      return;
+    if (
+      typeof settings.font !== "string" ||
+      !Object.hasOwn(fonts, settings.font)
+    )
+      return;
+    if (
+      !["artwork", "soft", "outline"].includes(String(settings.button)) ||
+      !["original", "roomy", "compact"].includes(String(settings.layout))
+    )
+      return;
+    const current = Number(settings.currentStrength),
+      damping = Number(settings.ropeDamping),
+      waves = Number(settings.waveAmplitude);
+    if (
+      ![current, damping, waves].every(Number.isFinite) ||
+      current < 0 ||
+      current > 500 ||
+      damping < 0.95 ||
+      damping > 0.999 ||
+      waves < 0 ||
+      waves > 45
+    )
+      return;
+    const ink = CONFIG.ink as unknown as Record<string, string>;
+    for (const key of allowedInk)
+      ink[key] = (settings.ink as Record<string, string>)[key];
+    // Mutate the shared objects: the running canvas renderer holds references to them.
+    (CONFIG.forces as { currentStrength: number }).currentStrength = current;
+    (CONFIG.rope as { swingDamping: number }).swingDamping = damping;
+    (CONFIG.water as { waveAmplitude: number }).waveAmplitude = waves;
+    const theme: Record<string, string> = {
+      void: ink.voidBottom,
+      deep: ink.voidTop,
+      ink: ink.waterMid,
+      surface: ink.surface,
+      splat: ink.splat,
+      gold: ink.rareGlow,
+      foam: "#f2ecff",
+    };
+    Object.entries(theme).forEach(([key, value]) =>
+      root.style.setProperty(`--sandbox-${key}`, rgb(value)),
+    );
+    root.style.setProperty("--sandbox-font", fonts[settings.font]);
+    root.dataset.sandboxFont = settings.font;
+    root.dataset.sandboxButton = String(settings.button);
+    root.dataset.sandboxLayout = String(settings.layout);
+    window.dispatchEvent(new Event("sandbox:style-applied"));
+    window.parent.postMessage(
+      { type: "winston:applied", version: 1, requestId: event.data.requestId },
+      origin,
+    );
+  };
+  window.addEventListener("message", message);
+  ready();
+  return () => {
+    window.removeEventListener("message", message);
+    Object.assign(CONFIG.ink, baseline.ink);
+    Object.assign(CONFIG.forces, baseline.forces);
+    Object.assign(CONFIG.rope, baseline.rope);
+    Object.assign(CONFIG.water, baseline.water);
+    Object.keys(root.dataset)
+      .filter((key) => key.startsWith("sandbox"))
+      .forEach((key) => delete root.dataset[key]);
+    [...root.style]
+      .filter((key) => key.startsWith("--sandbox-"))
+      .forEach((key) => root.style.removeProperty(key));
+  };
+}
